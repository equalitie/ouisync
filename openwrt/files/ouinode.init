#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	(umask 077; mkdir -p /srv/ouinode/repositories) || return 1

	procd_open_instance
	procd_set_param command /usr/bin/ouisync --config-dir /etc/ouinode start --log-color never
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 30
	procd_close_instance
}
